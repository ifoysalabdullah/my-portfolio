---
import BaseLayout from '../../layouts/BaseLayout.astro';

// The modern way to automatically grab every markdown file in Astro v7+
const posts = import.meta.glob('./*.md', { eager: true });
const allPosts = Object.values(posts);
---

<BaseLayout title="Blog | Foysal Abdullah">
  <main class="container" style="padding-top: 140px; max-width: 900px;">
    <h1 style="font-size: 3rem; font-weight: 800; margin-bottom: 40px; text-align: center;">
      My <span class="gradient-text">Blog</span>
    </h1>
    
    <div style="display: flex; flex-direction: column; gap: 24px;">
      {allPosts.map((post) => (
        <a href={post.url} class="glass-panel" style="padding: 30px; display: block; transition: 0.3s;">
          <h2 style="font-size: 1.5rem; margin-bottom: 10px;">{post.frontmatter.title}</h2>
          <p style="color: var(--text-muted);">{post.frontmatter.description}</p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>