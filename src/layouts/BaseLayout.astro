---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Foysal Abdullah | Motion Designer",
  description = "I turn static ideas into scroll-stopping visuals — built for SaaS, startups, and brands that want to stand out.",
  image = "/default-social-card.jpg" // Create a 1200x630 image and put it in your public folder!
} = Astro.props;
---

<head>
  <!-- Basic Meta Tags -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />

  <!-- Open Graph / Facebook / LinkedIn / Instagram -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />

  <!-- Twitter / X -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={new URL(image, Astro.url)} />
  
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <script is:inline src="/videos.js"></script>


  <!-- Cal.com embed initialization -->
  <script is:inline type="text/javascript">
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "30min", {origin:"https://app.cal.com"});
    Cal.ns["30min"]("ui", {"theme":"dark","cssVarsPerTheme":{"light":{"cal-brand":"#0088ff"},"dark":{"cal-brand":"#00ffff"}},"hideEventTypeDetails":false,"layout":"month_view"});
  </script>
</head>
<body>

<!-- Background Environment -->
  <div class="bg-environment">
    <div class="orb"></div>

    <!-- Night Mode: Rich Galaxy Field -->
    <div class="stars">
      <!-- Small Twinkling Stars -->
      <div class="star" style="top: 10%; left: 20%; width: 2px; height: 2px; animation-duration: 2.5s;"></div>
      <div class="star" style="top: 18%; left: 75%; width: 3px; height: 3px; animation-duration: 4s; animation-delay: 1s;"></div>
      <div class="star" style="top: 28%; left: 45%; width: 2px; height: 2px; animation-duration: 3s; animation-delay: 0.5s;"></div>
      <div class="star" style="top: 40%; left: 12%; width: 3px; height: 3px; animation-duration: 5s; animation-delay: 2s;"></div>
      <div class="star" style="top: 55%; left: 88%; width: 2px; height: 2px; animation-duration: 3.5s; animation-delay: 1.5s;"></div>
      <div class="star" style="top: 68%; left: 35%; width: 3px; height: 3px; animation-duration: 4.5s;"></div>
      <div class="star" style="top: 78%; left: 65%; width: 2px; height: 2px; animation-duration: 2.8s; animation-delay: 2.2s;"></div>
      <div class="star" style="top: 85%; left: 18%; width: 3px; height: 3px; animation-duration: 3.8s; animation-delay: 0.8s;"></div>
      <div class="star" style="top: 92%; left: 82%; width: 2px; height: 2px; animation-duration: 4.2s; animation-delay: 1.2s;"></div>

      <!-- Multiple Shooting Stars with Staggered Delays -->
      <div class="shooting-star" style="top: 8%; right: 15%; animation-delay: 0s;"></div>
      <div class="shooting-star" style="top: 22%; right: 40%; animation-delay: 3.5s; width: 180px;"></div>
      <div class="shooting-star" style="top: 45%; right: 5%; animation-delay: 6s; width: 120px;"></div>
    </div>

    <!-- Day Mode: Clouds -->
    <div class="clouds">
      <div class="cloud cloud-ltr" style="top: 15%; width: 350px; height: 120px;"></div>
      <div class="cloud cloud-rtl" style="top: 60%; width: 500px; height: 150px; animation-delay: -20s;"></div>
    </div>
  </div>

  <!-- Slim Header -->
  <header>
    <nav class="glass-panel">
      <a href="/" class="logo">
        <img src="/favicon.png" alt="Logo" style="width: 28px; height: 28px; border-radius: 6px; object-fit: cover; box-shadow: 0 2px 10px rgba(0,255,255,0.2);">
        Foysal Abdullah
      </a>
      <ul class="nav-links">
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/blog">Blog</a></li>
      </ul>
      <div style="display: flex; gap: 10px; align-items: center;">
        <button id="theme-toggle" class="theme-toggle" title="Toggle Theme"></button>
        <button data-cal-link="foysalabdullah/30min" data-cal-namespace="30min" class="glass-button primary" style="padding: 8px 16px;">Contact</button>
      </div>
    </nav>
  </header>

  <!-- Page Content Injected Here -->
  <slot />

  <!-- Lightbox Modal -->
  <div id="lightbox" class="lightbox">
    <div class="lightbox-content">
      <div class="lightbox-close">&times;</div>
      <div id="lightbox-iframe-container"></div>
    </div>
  </div>

  <!-- Slim Footer -->
  <footer>
    <div class="glass-panel footer-inner">
      <p>© 2026 Foysal Abdullah. All Rights Reserved. | <a href="/privacy" style="text-decoration: underline; color: var(--cyan);">Privacy Policy</a> | <a href="/blog" style="text-decoration: underline; color: var(--cyan);">blog</a></p>
      <div class="footer-links">
        <a href="https://www.behance.net/ifoysalabdullah" target="_blank">Behance</a>
        <a href="https://www.youtube.com/@ifoysalabdullah" target="_blank">YouTube</a>
        <a href="https://www.linkedin.com/in/ifoysalabdullah/" target="_blank">LinkedIn</a>
      </div>
    </div>
  </footer>

  <script is:inline src="/app.js"></script>
</body>
</html>